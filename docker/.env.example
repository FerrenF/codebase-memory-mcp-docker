# Copy to docker/.env and edit. This is the only file you need to change.

# ── Workspace ──────────────────────────────────────────────────────────────
# Absolute host path containing the repositories to index; mounted at the same path in the container.
# Pick a parent directory (e.g. ~/code), not a single repo, so one container serves all your projects. No "~".
CBM_WORKSPACE=/home/you/code

# (macOS/Windows) the defaults are fine. (Linux) your `id -u` / `id -g`.
CBM_UID=1000
CBM_GID=1000

# ── CBM Lens (web UI) ──────────────────────────────────────────────────────
CBM_UI_PORT=9749
# Host address the UI port is published on. It only answers to localhost anyway; use the proxy below for other machines.
CBM_UI_BIND=127.0.0.1

# ── MCP over HTTP (/mcp streamable, /sse) — what MCP gateways connect to ──
CBM_HTTP_PORT=8811
# Host address the MCP port is published on. 0.0.0.0 exposes it unauthenticated to your network.
CBM_HTTP_BIND=127.0.0.1
# Existing Docker network of your MCP gateway; only used with compose.gateway.yaml.
#GATEWAY_NETWORK=harbor_harbor-network

# ── HTTPS proxy for CBM Lens ──────────────────────────────────────────────
# Comma-separated hostnames and/or IPs people will type to reach this machine. The first is the certificate CN.
# Drives the certificate SANs and the allowed Origins; changing it regenerates the self-signed cert.
PROXY_HOSTS=cbm.lan,192.168.1.129
PROXY_PORT=8443
PROXY_BIND=0.0.0.0
# PROXY_CERT_DAYS=825
# Set both to require a login.
# PROXY_AUTH_USER=you
# PROXY_AUTH_PASSWORD=change-me

# ── Build ──────────────────────────────────────────────────────────────────
# CBM_IMAGE=ferrenf/codebase-memory-mcp:latest
# Stamp a version into the binary (otherwise "dev").
# CBM_VERSION=0.11.0
# Limit parallel compile jobs if the build gets OOM-killed. 0 = all cores.
# CBM_BUILD_JOBS=2
