# Copy to docker/.env and edit.

# - Absolute host path that contains the repositories you want indexed. It is mounted into the container at the same path. 
# - Pick a parent directory (e.g. ~/code), not a single repo, so one container serves all your projects.
# - Must be an absolute path — no "~".

CBM_WORKSPACE=/home/you/code

# (macOS/Windows) the defaults are fine. (Linux) depends on your setup.
CBM_UID=1000
CBM_GID=1000

# CBM Lens (web UI) port.
CBM_UI_PORT=9749
# CBM Lens (web UI) listen address.
CBM_LISTEN_ADDR=0.0.0.0
# Optional: put version into the binary (otherwise "dev").
# CBM_VERSION=0.11.0

# Agentic access to tools
CBM_HTTP_PORT=8811
# Optional: limit parallel compile jobs if the build gets OOM-killed. 0 = all cores.
# CBM_BUILD_JOBS=2

# CSV. The IP addresses that host the server. e.g. 192.168.1.5,104.55.225.3
PROXY_CERT_SANS=192.168.1.129
# CSV. The domain name patterns for which point to the server.
PROXY_CERT_CN=cbm.lan

PROXY_HOST=192.168.1.129
PROXY_PORT=8443


# The name of the network that your harbor container uses, if you have one.
#HARBOR_NETWORK=harbor_harbor-network

